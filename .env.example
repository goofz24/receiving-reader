# Copy this file to .env and paste your key. .env is ignored by git, so the key never goes to GitHub.
ANTHROPIC_API_KEY=

# Optional. Model used by the app and by `npm run eval` (default: claude-haiku-5-5).
# CLAUDE_MODEL=claude-haiku-5-5

# Optional. This project refuses paid calls once its total spend reaches this many dollars (default 2).
# SPEND_LIMIT_USD=2
